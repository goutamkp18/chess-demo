# =====================================================================
# CHESS ARENA ENVIRONMENT CONFIGURATION
# =====================================================================

# Server Port
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------
# SUPABASE CONFIGURATION (Recommended for production & cloud deployment)
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
# ---------------------------------------------------------------------
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (recommended for server) or Anon Key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ---------------------------------------------------------------------
# DIRECT POSTGRESQL CONNECTION (Optional alternative to Supabase SDK)
# Obtain from: Supabase Settings -> Database -> Connection string (URI)
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------
# CLIENT CONFIGURATION
# Point this to your Render / cloud backend deployment in production
# ---------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:4000
