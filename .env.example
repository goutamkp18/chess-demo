# Server Configuration
PORT=4000
NODE_ENV=development

# Optional: Supabase / PostgreSQL Database URL
# If omitted, Chess Arena utilizes the embedded zero-dependency ACID disk store in server/data/chess_arena_db.json
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/chess_arena

# Client Configuration
# In production, point this to your Render backend deployment (e.g., https://chess-arena-server.onrender.com)
VITE_BACKEND_URL=http://localhost:4000

